# ========================================================
# Shree Pratham Environment Configuration (Example)
# ========================================================

# 1. Razorpay Payment Gateway API Key (Test or Live Key ID)
# Get your Key ID from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_51ShreePrathamKey

# 2. Official Corporate Sales Email (Sender Address for Order Confirmations)
VITE_SALES_EMAIL=sales@shreepratham.com

# 3. Shiprocket Logistics & Courier Partner Configuration
# To connect your live Shiprocket account:
# - Log in at https://app.shiprocket.in/
# - Go to Settings -> API -> Configure API Users -> Click "Add New API User"
# - Set your API user email and password below
VITE_SHIPROCKET_EMAIL=logistics@shreepratham.com
VITE_SHIPROCKET_PASSWORD=your_shiprocket_api_password
VITE_SHIPROCKET_PICKUP_LOCATION=Mumbai Central Fulfillment Hub
VITE_SHIPROCKET_PICKUP_PINCODE=400050

# 4. Optional: External Mail Delivery Provider
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
# VITE_EMAIL_WEBHOOK_URL=

# 5. Supabase Database Configuration (Recommended)
# Connects Admin Panel -> Website live product catalog in real time!
# Get these 2 values from: https://supabase.com -> Project Settings -> API
# - Project URL: https://xyzcompany.supabase.co
# - Project API Keys: anon (public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 6. Admin Panel Credentials
# Set your preferred Admin password here:
VITE_ADMIN_PASSWORD=shree.pratham25

# 7. (Optional Legacy) Firebase Configuration
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

