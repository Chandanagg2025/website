# ========================================================
# Shree Pratham Environment Configuration (Example)
# ========================================================

# 1. Razorpay Payment Gateway API Key (Test or Live Key ID)
# Get your Key ID from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_51ShreePrathamKey

# 2. Official Corporate Sales Email (Sender Address for Order Confirmations)
VITE_SALES_EMAIL=sales@shreepratham.com

# 3. Shiprocket Logistics & Courier Partner Configuration
# To connect your live Shiprocket account:
# - Log in at https://app.shiprocket.in/
# - Go to Settings -> API -> Configure API Users -> Click "Add New API User"
# - Set your API user email and password below
VITE_SHIPROCKET_EMAIL=logistics@shreepratham.com
VITE_SHIPROCKET_PASSWORD=your_shiprocket_api_password
VITE_SHIPROCKET_PICKUP_LOCATION=Mumbai Central Fulfillment Hub
VITE_SHIPROCKET_PICKUP_PINCODE=400050

# 4. Optional: External Mail Delivery Provider
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
# VITE_EMAIL_WEBHOOK_URL=

# 5. Firebase (connects Admin Panel -> Website product catalog)
# Used by BOTH the website and admin-panel/ (admin-panel reads this root .env via envDir).
# Get these from: Firebase Console -> Project settings -> General -> Your apps -> Web app config.
# These web config values are not secret; security is enforced by firestore.rules.
# On Vercel, add the same variables to BOTH projects (website and admin panel).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated admin email(s) allowed to sign in to the admin panel (UI check only;
# the real protection is the email list in firestore.rules).
VITE_ADMIN_EMAILS=admin@shreepratham.com
